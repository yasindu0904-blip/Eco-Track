<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="M2 read-only baseline" enabled="true"><boolProp name="TestPlan.functional_mode">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Bounded reads" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(users,1)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(rampSeconds,10)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(durationSeconds,60)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp></ThreadGroup><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Private bearer" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="Authorization" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__P(accessToken,)}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Five second think time" enabled="true"><stringProp name="ConstantTimer.delay">5000</stringProp></ConstantTimer><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Categories" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${__P(apiHost,p01--eco-track--xnjn7t9fk69n.code.run)}</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.path">/api/v1/incident-categories</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Status and known data" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">try { assert prev.responseCode == '200'; def body=new groovy.json.JsonSlurper().parseText(prev.responseDataAsString); assert body.data instanceof List; assert body.data.size()&gt;0; assert body.data.every { it.id &amp;&amp; it.name } } catch (Throwable e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Status/schema/known-fixture assertion failed'); }</stringProp></JSR223Assertion><hashTree/></hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Nearby incidents" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${__P(apiHost,p01--eco-track--xnjn7t9fk69n.code.run)}</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.path">/api/v1/incidents/nearby?latitude=${__P(latitude,6.795)}&amp;longitude=${__P(longitude,79.94)}&amp;radiusMeters=2000</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Status and known data" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">try { assert prev.responseCode == '200'; def body=new groovy.json.JsonSlurper().parseText(prev.responseDataAsString); assert body.data.items instanceof List; def expected=props.get('expectedIncidentId'); assert expected; assert body.data.items.any { it.id == expected } } catch (Throwable e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Status/schema/known-fixture assertion failed'); }</stringProp></JSR223Assertion><hashTree/></hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Nearby events" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${__P(apiHost,p01--eco-track--xnjn7t9fk69n.code.run)}</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.path">/api/v1/events/nearby?latitude=${__P(latitude,6.795)}&amp;longitude=${__P(longitude,79.94)}&amp;radiusMeters=2000</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Status and known data" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">try { assert prev.responseCode == '200'; def body=new groovy.json.JsonSlurper().parseText(prev.responseDataAsString); assert body.data.type == 'FeatureCollection'; assert body.data.features instanceof List; def expected=props.get('expectedEventId'); assert expected; assert body.data.features.any { it.properties.id == expected } } catch (Throwable e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Status/schema/known-fixture assertion failed'); }</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree></hashTree></hashTree></jmeterTestPlan>