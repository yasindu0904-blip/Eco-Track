# Copy this file to .env.docker. Never commit .env.docker.

# Hosted Supabase database used by the normal compose.yaml stack. The optional
# local database Compose file overrides this value inside the backend container.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/postgres

# Supabase Auth and backend Storage values. The service-role key is passed only
# to the backend container; never expose it through a VITE_ or EXPO_PUBLIC_ key.
SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SUPABASE_SERVICE_ROLE_KEY
INCIDENT_EVIDENCE_BUCKET=incident-evidence

# Browser-facing addresses on the Windows host.
WEB_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=http://localhost:5000/api/v1
BACKEND_PORT=5000
WEB_PORT=8080

# Optional bootstrap values used by the existing backend configuration.
SUPER_ADMIN_AUTH_USER_ID=
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_FULL_NAME=EcoTrack Super Admin
