# Copy to submission/.env.local ONLY when overriding the defaults.
# These credentials belong only to the disposable local submission containers.
SUBMISSION_DATABASE_URL=postgresql://postgres:submission_test@127.0.0.1:55439/ecotrack_submission_test?schema=public&options=-c%20search_path%3Dpublic%2Cextensions
SUBMISSION_REDIS_URL=redis://127.0.0.1:56389
SUBMISSION_API_ORIGIN=http://127.0.0.1:5025
SUBMISSION_WEB_ORIGIN=http://localhost:5173

# The automated suites use injected Auth/Storage dependencies; no real keys needed.
# Configure these for interactive login/Storage checks against a TEST project.
SUBMISSION_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
SUBMISSION_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PROJECT_PUBLISHABLE_KEY
SUBMISSION_SUPABASE_SERVICE_ROLE_KEY=

# Compile-only web build defaults use placeholders; supply matching public values
# here to produce a web build that can actually sign in.
SUBMISSION_WEB_API_BASE_URL=http://127.0.0.1:5025/api/v1

# Smoke/load use GET requests. Remote targets and load require explicit opt-in.
SUBMISSION_ALLOW_REMOTE=false
SUBMISSION_ALLOW_LOAD_TEST=false
SUBMISSION_JMETER_BIN=PATH_TO_JMETER_BIN_JMETER_OR_JMETER_BAT
SUBMISSION_ACCESS_TOKEN=
SUBMISSION_EXPECTED_INCIDENT_ID=
SUBMISSION_EXPECTED_EVENT_ID=
SUBMISSION_LATITUDE=6.795
SUBMISSION_LONGITUDE=79.94
SUBMISSION_LOAD_USERS=1
SUBMISSION_LOAD_RAMP_SECONDS=10
SUBMISSION_LOAD_DURATION_SECONDS=60
