NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
DATABASE_POOL_MAX=5
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379
REDIS_KEY_PREFIX=ecotrack:development
NOTIFICATION_DISPATCH_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
# Optional; only required if Expo Enhanced Push Security is enabled.
EXPO_ACCESS_TOKEN=
SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_KEY
# Required for backend Storage/admin operations; never place in client config.
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
INCIDENT_EVIDENCE_BUCKET=incident-evidence
EVENT_EVIDENCE_BUCKET=event-evidence
# Seed-only controlled admin identity; leave UUID empty if not seeding an admin.
SUPER_ADMIN_AUTH_USER_ID=
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_FULL_NAME=EcoTrack Super Admin
