Project EcoTrack_ERD_v2_Simplified {
  database_type: 'PostgreSQL'
  Note: '''
  EcoTrack ERD v2 - simplified MVP-focused design.

  Main rules:
  - Supabase Auth manages passwordless magic-link identity.
  - Every normal account has both Citizen and Volunteer capabilities.
  - Incidents are shared platform records; organization visibility is derived from PostGIS service-area coverage.
  - Each organization reviews an incident independently as VIEWED, VALID, or FALSE.
  - Cleanup events belong to one organization and may optionally link to one incident.
  - Only one active cleanup event may exist for an incident at a time.
  - Volunteers join immediately; availability and actual session allocation are separate.
  - Audit logs replace several separate status-history tables that were not needed for the MVP.
  - Cleanup workflow configuration is simplified to organization-specific statuses and transitions.
  - Incident highlight/archive durations come from permanent platform settings.
  - PostgreSQL real-moment timestamps use TIMESTAMPTZ; DATE/TIME remain for local session scheduling fields.
  - PostGIS uses geography(Point, 4326) for points and geography(MultiPolygon, 4326) for service areas.
  - DRAFT cleanup events do not claim incidents. PUBLISHED, SCHEDULED, IN_PROGRESS, and COMPLETION_SUBMITTED are the incident-claiming lifecycle states.
  - Supabase auth.users remains externally owned. user_profiles.auth_user_id is a unique logical identity link and must not become a normal Prisma-managed cross-schema foreign key unless deliberately implemented later with reviewed Supabase SQL.
  - Every public application table must receive the project's backend-only RLS / privilege-revocation treatment in migrations.
  - Cross-organization and cross-event relationships must be protected by database constraints where practical and by transactional service validation plus Organization A / Organization B tests where a direct FK cannot express the rule.
  '''
}

// ============================================================
// ENUMS
// ============================================================

Enum platform_role {
  USER
  SUPER_ADMIN
}

Enum account_status {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

Enum organization_status {
  PENDING_REVIEW
  ACTIVE
  DECLINED
  SUSPENDED
  ARCHIVED
}

Enum document_review_status {
  PENDING
  VERIFIED
  REJECTED
}

Enum service_area_status {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  INACTIVE
}

Enum membership_role {
  ORG_MEMBER
  ORG_ADMIN
}

Enum membership_status {
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

Enum membership_request_status {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

Enum membership_source {
  REQUEST_APPROVED
  ADMIN_ADDED
  FIRST_ADMIN
}

Enum incident_severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum incident_status {
  ACTIVE
  CLEANUP_ORGANIZED
  RESOLVED
  EXPIRED
  ARCHIVED
}

Enum incident_review_status {
  VIEWED
  VALID
  FALSE
}

Enum cleanup_lifecycle_status {
  DRAFT
  PUBLISHED
  SCHEDULED
  IN_PROGRESS
  COMPLETION_SUBMITTED
  COMPLETED
  CANCELLED
}

Enum session_status {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum participant_status {
  JOINED
  WITHDRAWN
  REMOVED
}

Enum allocation_status {
  PLANNED
  ATTENDED
  ABSENT
  REMOVED
}

Enum note_visibility {
  PARTICIPANTS
  INTERNAL
}

Enum evidence_type {
  BEFORE
  PROGRESS
  AFTER
}

Enum notification_type {
  INCIDENT_STATUS_CHANGED
  NEW_INCIDENT_IN_AREA
  EVENT_PUBLISHED
  EVENT_JOINED
  SESSION_ALLOCATED
  EVENT_UPDATED
  EVENT_CANCELLED
  EVENT_COMPLETED
  MEMBERSHIP_UPDATED
  ORGANIZATION_REVIEW_UPDATED
  ACHIEVEMENT_AWARDED
  GENERAL
}

Enum issue_status {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

Enum contribution_type {
  VERIFIED_INCIDENT_REPORT
  SESSION_ATTENDED
  EVENT_COMPLETED
  SPECIAL_CONTRIBUTION
}

// ============================================================
// AUTHENTICATION AND USER PROFILE
// ============================================================

Table auth.users [note: 'External Supabase-owned table shown for architecture context only. Do not model this as a normal Prisma-managed relation or application-owned FK without a deliberate reviewed Supabase-specific SQL decision.'] {
  id uuid [pk]
  email varchar [not null, unique]
  email_confirmed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table public.user_profiles [headerColor: #4C78A8] {
  id uuid [pk]
  auth_user_id uuid [not null, unique, note: 'Logical link to Supabase Auth user ID. Keep unique in Prisma; no normal Prisma-managed FK to auth.users.']
  email varchar [not null, unique, note: 'Synchronized read-only application copy of the verified Supabase email. Supabase Auth remains the identity/email authority.']
  full_name varchar
  phone_number varchar
  platform_role platform_role [not null, default: 'USER']
  account_status account_status [not null, default: 'ACTIVE']
  profile_completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  Note: 'Every normal profile automatically has Citizen and Volunteer capabilities. No separate citizen or volunteer table is required. email is synchronized from the verified Supabase identity during provisioning/login and is not independently editable as an EcoTrack identity field.'
}

// ============================================================
// PLATFORM CONFIGURATION
// ============================================================

Table public.platform_settings [headerColor: #9C755F] {
  id int [pk, default: 1, note: 'Singleton application-settings row. Application logic/migration should enforce id = 1.']
  incident_highlight_hours int [not null, default: 48, note: 'Duration used to calculate incidents.highlight_until at incident creation. Must be positive.']
  incident_unaddressed_days int [not null, default: 7, note: 'Additional unaddressed period used to calculate incidents.archive_after. Must be positive.']
  updated_by_user_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Permanent source for configurable incident visibility durations. Seed the singleton row. Add CHECK constraints for id = 1 and positive duration values.'
}

// ============================================================
// ORGANIZATION ONBOARDING, AREAS, AND MEMBERSHIP
// ============================================================

Table public.organizations [headerColor: #59A14F] {
  id uuid [pk]
  requested_by_user_id uuid [not null]
  name varchar [not null]
  slug varchar [not null, unique]
  registration_number varchar
  description text
  official_email varchar [not null]
  official_phone varchar [not null]
  official_address text [not null]
  status organization_status [not null, default: 'PENDING_REVIEW']
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  review_notes text
  activated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  Note: 'Represents an existing real-world organization requesting an EcoTrack workspace; EcoTrack does not create the real organization itself.'
}

Table public.organization_verification_documents [headerColor: #59A14F] {
  id uuid [pk]
  organization_id uuid [not null]
  document_type varchar [not null]
  storage_path varchar [not null]
  original_file_name varchar [not null]
  review_status document_review_status [not null, default: 'PENDING']
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  review_notes text
  expires_at date
  uploaded_at timestamptz [not null, default: `now()`]

  Note: 'Separate table is required because one organization can upload several proof documents.'
}

Table public.organization_service_areas [headerColor: #59A14F] {
  id uuid [pk]
  organization_id uuid [not null]
  area_name varchar [not null]
  boundary geography(MultiPolygon,4326) [not null, note: 'Approved service-area boundary. Add a spatial GiST index in migration SQL.']
  status service_area_status [not null, default: 'PENDING_REVIEW']
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  review_notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id
  }

  Note: 'An active organization must have at least one ACTIVE service area. The boundary determines which shared incidents the organization can discover.'
}

Table public.organization_memberships [headerColor: #59A14F] {
  id uuid [pk]
  organization_id uuid [not null]
  user_id uuid [not null]
  role membership_role [not null, default: 'ORG_MEMBER']
  status membership_status [not null, default: 'ACTIVE']
  source membership_source [not null]
  source_request_id uuid [unique]
  added_or_approved_by_membership_id uuid
  joined_at timestamptz [not null, default: `now()`]
  ended_at timestamptz

  indexes {
    (organization_id, user_id) [unique]
    (organization_id, role, status)
  }

  Note: 'A user can be a member/admin in several organizations. Citizens may request only ORG_MEMBER; ORG_ADMIN is granted by an authorized admin or as the first admin.'
}

Table public.organization_membership_requests [headerColor: #59A14F] {
  id uuid [pk]
  organization_id uuid [not null]
  requester_user_id uuid [not null]
  message text
  status membership_request_status [not null, default: 'PENDING']
  reviewed_by_membership_id uuid
  reviewed_at timestamptz
  review_notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, requester_user_id, status)
  }

  Note: 'Request is always for ORG_MEMBER. A partial unique index should prevent more than one PENDING request for the same user and organization.'
}

// ============================================================
// SIMPLIFIED ORGANIZATION CLEANUP WORKFLOW
// ============================================================

Table public.cleanup_workflow_statuses [headerColor: #B279A2] {
  id uuid [pk]
  organization_id uuid [not null]
  code varchar [not null]
  label varchar [not null]
  mapped_lifecycle_status cleanup_lifecycle_status [not null]
  position int [not null]
  is_initial boolean [not null, default: false]
  is_final boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, code) [unique]
    (organization_id, position) [unique]
    (organization_id, id) [unique, note: 'Supports tenant-safe composite foreign keys from transitions/events.']
  }

  Note: 'Each organization has one cleanup-event workflow for the MVP. This replaces the older workflow_definitions table.'
}

Table public.cleanup_workflow_transitions [headerColor: #B279A2] {
  id uuid [pk]
  organization_id uuid [not null]
  from_status_id uuid [not null]
  to_status_id uuid [not null]

  indexes {
    (organization_id, from_status_id, to_status_id) [unique]
  }

  Note: 'Defines which organization-specific cleanup statuses may follow one another. organization_id plus composite foreign keys must guarantee that both from/to statuses belong to this same organization. Role permissions remain in CASL/application authorization.'
}

// ============================================================
// SHARED INCIDENT REPORTING AND ORGANIZATION REVIEW
// ============================================================

Table public.incident_categories [headerColor: #F28E2B] {
  id uuid [pk]
  name varchar [not null, unique]
  description text
  is_active boolean [not null, default: true]
}

Table public.incidents [headerColor: #F28E2B] {
  id uuid [pk]
  reporter_user_id uuid [not null]
  category_id uuid [not null]
  title varchar [not null]
  description text [not null]
  severity incident_severity [not null]
  status incident_status [not null, default: 'ACTIVE']
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  geo_point geography(Point,4326) [not null, note: 'Keep synchronized from longitude/latitude using controlled DB logic (prefer trigger/generated mechanism) and add a spatial GiST index.']
  address_text text
  highlight_until timestamptz [not null, note: 'Calculated at creation from platform_settings.incident_highlight_hours. Stored per incident so later setting changes do not silently rewrite historical deadlines.']
  archive_after timestamptz [not null, note: 'Calculated at creation from the configured highlight/unaddressed durations. Stored per incident for deterministic lifecycle processing.']
  reported_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  archived_at timestamptz

  indexes {
    (status, reported_at)
    category_id
    reporter_user_id
  }

  Note: 'Shared platform record with no organization_id. Covering organizations are derived by spatially comparing geo_point with ACTIVE organization_service_areas.'
}

Table public.incident_photos [headerColor: #F28E2B] {
  id uuid [pk]
  incident_id uuid [not null]
  storage_path varchar [not null]
  thumbnail_path varchar
  caption varchar
  sort_order int [not null, default: 0]
  uploaded_at timestamptz [not null, default: `now()`]
}

Table public.incident_reviews [headerColor: #F28E2B] {
  id uuid [pk]
  incident_id uuid [not null]
  organization_id uuid [not null]
  status incident_review_status [not null]
  reason_code varchar
  private_notes text
  reviewed_by_membership_id uuid [not null]
  first_viewed_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (incident_id, organization_id) [unique]
    (incident_id, status)
  }

  Note: 'One current review per organization per incident. FALSE count is derived by counting distinct current FALSE rows; it is never stored on incidents.'
}

Table public.incident_status_history [headerColor: #F28E2B] {
  id uuid [pk]
  incident_id uuid [not null]
  from_status incident_status
  to_status incident_status [not null]
  changed_by_user_id uuid
  related_cleanup_event_id uuid
  reason text
  changed_at timestamptz [not null, default: `now()`]

  Note: 'Stores the reporter-visible shared lifecycle history: ACTIVE, CLEANUP_ORGANIZED, RESOLVED, EXPIRED, and ARCHIVED. Organization review changes are recorded in audit_logs instead of a second review-history table.'
}

// ============================================================
// ORGANIZATION-OWNED CLEANUP EVENTS
// ============================================================

Table public.cleanup_events [headerColor: #E15759] {
  id uuid [pk]
  organization_id uuid [not null]
  incident_id uuid [note: 'NULL for a direct cleanup event.']
  current_workflow_status_id uuid [not null, note: 'Must reference a workflow status belonging to the same organization as this event.']
  lifecycle_status cleanup_lifecycle_status [not null, default: 'DRAFT']
  created_by_membership_id uuid [not null]
  title varchar [not null]
  description text [not null]
  public_instructions text
  event_latitude decimal(9,6) [not null]
  event_longitude decimal(9,6) [not null]
  event_geo_point geography(Point,4326) [not null, note: 'Keep synchronized from event_longitude/event_latitude using controlled DB logic (prefer trigger/generated mechanism) and add a spatial GiST index.']
  event_address text
  meeting_latitude decimal(9,6)
  meeting_longitude decimal(9,6)
  meeting_geo_point geography(Point,4326) [note: 'If present, keep synchronized with meeting_longitude/meeting_latitude.']
  meeting_address text
  published_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancellation_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    incident_id [note: 'Migration SQL must add a partial UNIQUE index on incident_id for lifecycle_status IN (PUBLISHED, SCHEDULED, IN_PROGRESS, COMPLETION_SUBMITTED). DRAFT, COMPLETED, and CANCELLED do not claim/block an incident.']
    (organization_id, lifecycle_status, created_at)
  }

  Note: 'Belongs to exactly one organization. It may be linked to one incident or be created directly with incident_id NULL. A DRAFT linked event does not claim the incident; the claim is acquired atomically when entering a claiming lifecycle state. current_workflow_status_id and created_by_membership_id must belong to the owning organization.'
}

Table public.event_sessions [headerColor: #E15759] {
  id uuid [pk]
  cleanup_event_id uuid [not null]
  session_date date [not null]
  start_time time [not null]
  end_time time [not null]
  capacity int
  status session_status [not null, default: 'SCHEDULED']
  location_latitude decimal(9,6)
  location_longitude decimal(9,6)
  location_geo_point geography(Point,4326) [note: 'If present, keep synchronized with location_longitude/location_latitude.']
  location_address text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (cleanup_event_id, session_date, start_time) [unique]
  }

  Note: 'One row per real date/time period. Multi-day events therefore use several rows rather than a date list in cleanup_events.'
}

Table public.event_coordinators [headerColor: #E15759] {
  id uuid [pk]
  cleanup_event_id uuid [not null]
  membership_id uuid [not null]
  assigned_by_membership_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  removed_at timestamptz

  indexes {
    (cleanup_event_id, membership_id) [unique]
  }

  Note: 'Task-specific responsibility for an active member of the owning organization. It does not promote the member to ORG_ADMIN. membership_id and assigned_by_membership_id must belong to the same organization as the cleanup event.'
}

Table public.event_participants [headerColor: #E15759] {
  id uuid [pk]
  cleanup_event_id uuid [not null]
  user_id uuid [not null]
  status participant_status [not null, default: 'JOINED']
  joined_at timestamptz [not null, default: `now()`]
  withdrawn_at timestamptz
  removed_at timestamptz
  removed_by_membership_id uuid
  removal_reason text

  indexes {
    (cleanup_event_id, user_id) [unique]
  }

  Note: 'Created immediately when a citizen presses Join. There is no volunteer application or approval table.'
}

Table public.participant_session_availability [headerColor: #E15759] {
  participant_id uuid [not null]
  session_id uuid [not null]
  marked_at timestamptz [not null, default: `now()`]

  indexes {
    (participant_id, session_id) [pk]
  }

  Note: 'A row means the volunteer selected that session as available. The participant and session must belong to the same cleanup event; enforce in transactional service validation and preferably a database trigger/constraint where practical.'
}

Table public.session_allocations [headerColor: #E15759] {
  id uuid [pk]
  participant_id uuid [not null]
  session_id uuid [not null]
  allocated_by_membership_id uuid [not null]
  status allocation_status [not null, default: 'PLANNED']
  allocated_at timestamptz [not null, default: `now()`]
  attendance_marked_by_membership_id uuid
  attendance_marked_at timestamptz
  notes text

  indexes {
    (participant_id, session_id) [unique]
  }

  Note: 'Stores the organization\'s actual scheduling decision and later attendance. This is separate from volunteer-selected availability. participant_id and session_id must belong to the same cleanup event, and allocator/attendance memberships must belong to the event-owning organization.'
}

Table public.event_notes [headerColor: #E15759] {
  id uuid [pk]
  cleanup_event_id uuid [not null]
  author_membership_id uuid [not null]
  visibility note_visibility [not null, default: 'PARTICIPANTS']
  note_text text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'PARTICIPANTS notes are visible to joined volunteers; INTERNAL notes remain organization-only. author_membership_id must belong to the cleanup event owning organization.'
}

Table public.event_evidence [headerColor: #E15759] {
  id uuid [pk]
  cleanup_event_id uuid [not null]
  session_id uuid
  uploaded_by_user_id uuid [not null]
  type evidence_type [not null]
  storage_path varchar [not null]
  thumbnail_path varchar
  caption text
  uploaded_at timestamptz [not null, default: `now()`]
}

Table public.event_status_history [headerColor: #E15759] {
  id uuid [pk]
  cleanup_event_id uuid [not null]
  from_workflow_status_id uuid
  to_workflow_status_id uuid [not null]
  changed_by_membership_id uuid [not null]
  notes text
  changed_at timestamptz [not null, default: `now()`]

  Note: 'Stores the cleanup-event status timeline shown to participants and organization users. from/to workflow statuses and changed_by_membership_id must belong to the cleanup event owning organization.'
}

// ============================================================
// REWARDS, NOTIFICATIONS, SUPPORT, AND AUDIT
// ============================================================

Table public.contribution_events [headerColor: #EDC948] {
  id uuid [pk]
  user_id uuid [not null]
  type contribution_type [not null]
  incident_id uuid
  session_allocation_id uuid
  cleanup_event_id uuid
  points int [not null]
  recorded_by_user_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }

  Note: 'Immutable reason for points. A CHECK constraint should ensure the source column matches the contribution type and prevent duplicate awards.'
}

Table public.achievement_definitions [headerColor: #EDC948] {
  id uuid [pk]
  code varchar [not null, unique]
  name varchar [not null]
  description text [not null]
  threshold_points int
  highlight_on_map boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table public.user_achievements [headerColor: #EDC948] {
  id uuid [pk]
  user_id uuid [not null]
  achievement_id uuid [not null]
  awarded_from_contribution_id uuid
  awarded_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, achievement_id) [unique]
  }
}

Table public.user_devices [headerColor: #76B7B2] {
  id uuid [pk]
  user_id uuid [not null]
  expo_push_token varchar [not null, unique]
  platform varchar [not null]
  is_active boolean [not null, default: true]
  registered_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz
}

Table public.notifications [headerColor: #76B7B2] {
  id uuid [pk]
  user_id uuid [not null]
  organization_id uuid
  type notification_type [not null]
  title varchar [not null]
  message text [not null]
  data jsonb
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, read_at, created_at)
  }

  Note: 'Permanent in-app notification record. Expo push is only a delivery mechanism.'
}

Table public.issue_reports [headerColor: #76B7B2] {
  id uuid [pk]
  reporter_user_id uuid [not null]
  organization_id uuid
  category varchar [not null]
  description text [not null]
  screenshot_path varchar
  app_platform varchar
  app_version varchar
  status issue_status [not null, default: 'OPEN']
  handled_by_user_id uuid
  resolution_notes text
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  Note: 'MVP allows one optional screenshot, so a separate issue-report attachments table is not required.'
}

Table public.audit_logs [headerColor: #76B7B2] {
  id uuid [pk]
  actor_user_id uuid
  organization_id uuid
  action varchar [not null]
  entity_type varchar [not null]
  entity_id uuid [not null]
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, created_at)
    (entity_type, entity_id)
    (actor_user_id, created_at)
  }

  Note: 'Generic audit trail for organization status changes, service-area changes, review changes, membership role changes, suspensions, and other security-significant actions. This removes the need for several separate history tables.'
}

// ============================================================
// MIGRATION-LEVEL SECURITY / INTEGRITY RULES
// ============================================================
// DBML cannot fully express all PostgreSQL/Supabase rules below. Codex must implement and review them in migration SQL:
// - Enable RLS and apply the project's backend-only access policy / privilege revocation to EVERY public application table.
// - Add GiST indexes for all PostGIS geography columns used in spatial lookup.
// - Add CHECK constraints for valid latitude [-90,90], longitude [-180,180], positive capacities/durations, and end_time > start_time.
// - Keep latitude/longitude and geography point columns synchronized using one controlled database mechanism; application code must not be able to leave them inconsistent.
// - Add the exact partial UNIQUE incident-claim index for PUBLISHED/SCHEDULED/IN_PROGRESS/COMPLETION_SUBMITTED events.
// - Prevent more than one PENDING membership request for the same organization/user with a partial UNIQUE index.
// - Enforce workflow transition organization consistency with composite foreign keys.
// - Protect event/workflow/member and participant/session consistency with composite FKs, triggers, or transactional validation where direct FKs are impractical.
